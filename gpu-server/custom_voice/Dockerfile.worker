FROM alpine/git:2.47.2@sha256:062a01ad7a0eb17cff382bc5e26086b4d710e56dfdfdf001109a49b6d9bd378c AS source
RUN git clone https://github.com/RobViren/KVoiceWalk.git /src \
    && cd /src \
    && git checkout 3a38c6030cc4657df073c67ded37cdf7627c4969 \
    && test "$(git rev-parse HEAD)" = "3a38c6030cc4657df073c67ded37cdf7627c4969" \
    && rm -rf /src/.git

FROM ghcr.io/remsky/kokoro-fastapi-gpu:v0.6.0@sha256:560e5ba33e78597cf35d266a5591c3ce7558dce318b3019fb6d94e28b466080b

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && uv pip install --python /app/.venv/bin/python --no-cache \
    librosa==0.11.0 \
    numpy==2.2.6 \
    resemblyzer==0.1.4 \
    scipy==1.15.3 \
    setuptools==80.8.0 \
    soundfile==0.13.1 \
    tqdm==4.67.1 \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R appuser:appuser /app/.venv
COPY --from=source /src /opt/kvoicewalk
COPY --chmod=0444 build_runtime.py /opt/custom-voice/build_runtime.py
COPY --chmod=0555 worker.py /opt/custom-voice/worker.py
COPY --chmod=0555 evaluator.py /opt/custom-voice/evaluator.py
COPY --chmod=0555 alignment.py /opt/custom-voice/alignment.py
COPY --chmod=0444 artifact.py /opt/custom-voice/artifact.py
COPY --chmod=0555 sbom.py /opt/custom-voice/sbom.py
RUN chmod 0555 /opt/custom-voice
ENV PYTHONPATH=/opt/custom-voice:/opt/kvoicewalk \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/cache \
    NUMBA_CACHE_DIR=/tmp/numba \
    KVOICEWALK_REVISION=3a38c6030cc4657df073c67ded37cdf7627c4969
WORKDIR /opt/kvoicewalk
USER appuser
ENTRYPOINT ["python3", "/opt/custom-voice/worker.py"]
