{
	auto_https off
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

:8080 {
	@unauthorized not header Authorization "Bearer {$SPEECH_DIRECT_API_KEY}"
	respond @unauthorized "Unauthorized" 401

	# Correlation values are secret-free and intentionally remain in structured
	# access logs. They are never Prometheus labels.
	log_append speech_request_id {http.request.header.X-Speech-Request-ID}
	log_append call_id {http.request.header.X-Call-ID}
	log_append turn_id {http.request.header.X-Turn-ID}

	reverse_proxy speech-tts:8880 {
		flush_interval -1
		header_up -Authorization
		header_up X-Speech-Request-ID {http.request.header.X-Speech-Request-ID}
		header_up X-Call-ID {http.request.header.X-Call-ID}
		header_up X-Turn-ID {http.request.header.X-Turn-ID}
	}
}
