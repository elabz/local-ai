# Copy to gpu-server/.speech-probe.env on PEA (mode 600, gitignored) for the
# scheduled controlled probe (speech/run_controlled_probe.sh).
#
# AUDIO_FILE        short, non-sensitive WAV used only by the probe. Generate it
#                   from the TTS route itself so no user audio is involved:
#                     curl -s http://192.168.70.144:8201/v1/audio/speech \
#                       -H "Authorization: Bearer $SPEECH_DIRECT_API_KEY" \
#                       -H 'Content-Type: application/json' \
#                       --data '{"model":"kokoro","voice":"af_heart",
#                                "input":"Controlled operations probe.",
#                                "response_format":"wav"}' \
#                       -o /home/boss/local-ai/private/speech-probe.wav
# LITELLM_API_KEY   virtual key granting heartcode-stt (max_parallel_requests 1)
# LITELLM_ADMIN_KEY master key; /spend/logs is admin-only
# SPEECH_DIRECT_API_KEY  same value as in gpu-server/.env (direct TTS edge)

AUDIO_FILE=/home/boss/local-ai/private/speech-probe.wav
LITELLM_API_KEY=sk-...
LITELLM_ADMIN_KEY=sk-...
SPEECH_DIRECT_API_KEY=...

# Optional overrides (defaults are in run_controlled_probe.sh):
# LITELLM_URL=http://192.168.70.152:4000
# SPEECH_DIRECT_URL=http://192.168.70.144:8201
# PROMETHEUS_URL=http://localhost:9099
# SPEECH_TTS_ENCODING_PROFILE=opus-40k
