{
  "title": "HeartCode Speech Operations", "uid": "heartcode-speech", "schemaVersion": 39, "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id":1,"type":"stat","title":"Model-aware health","gridPos":{"x":0,"y":0,"w":6,"h":5},"targets":[{"expr":"probe_success{job=\"speech-health\"}","legendFormat":"{{model_type}}"}]},
    {"id":2,"type":"timeseries","title":"Traffic (requests/s)","gridPos":{"x":6,"y":0,"w":9,"h":5},"targets":[{"expr":"sum by (operation) (rate(speech_requests_total[5m]))","legendFormat":"{{operation}}"}]},
    {"id":3,"type":"timeseries","title":"p95 latency","gridPos":{"x":15,"y":0,"w":9,"h":5},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,operation) (rate(speech_request_duration_seconds_bucket[15m])))","legendFormat":"{{operation}}"}]},
    {"id":4,"type":"timeseries","title":"Error ratio","gridPos":{"x":0,"y":5,"w":8,"h":5},"targets":[{"expr":"sum by (operation) (rate(speech_failures_total[5m])) / clamp_min(sum by (operation) (rate(speech_requests_total[5m])), 0.001)","legendFormat":"{{operation}}"}]},
    {"id":5,"type":"table","title":"Process placement","gridPos":{"x":8,"y":5,"w":8,"h":5},"targets":[{"expr":"speech_gpu_inventory_info","format":"table","instant":true}]},
    {"id":6,"type":"timeseries","title":"Model memory residency","gridPos":{"x":16,"y":5,"w":8,"h":5},"targets":[{"expr":"speech_gpu_process_memory_bytes","legendFormat":"{{process}}"}]},
    {"id":7,"type":"timeseries","title":"GPU utilization","gridPos":{"x":0,"y":10,"w":12,"h":5},"targets":[{"expr":"speech_gpu_utilization_percent","legendFormat":"{{gpu_uuid}}"}]},
    {"id":8,"type":"timeseries","title":"Workload units","gridPos":{"x":12,"y":10,"w":12,"h":5},"targets":[{"expr":"sum by (operation,unit) (rate(speech_workload_units_total[5m]))","legendFormat":"{{operation}} {{unit}}"}]}
  ]
}
